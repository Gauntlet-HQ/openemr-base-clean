# Possible options are prod or dev. No spaces, no quotes.
OPENEMR__ENVIRONMENT=
# Set to true to disable periodic background service execution (Ajax piggybacking).
# Session timeouts and notification badges remain active. Accepts true/1 or false/0.
OPENEMR__NO_BACKGROUND_TASKS=
# Server-side OpenAI API key used by the AI patient-history summary feature.
# Required to enable the summary; leave blank to disable. Never commit a real key.
# In production, only send PHI once a BAA (with zero data retention) is in place.
OPENAI_API_KEY=
# Optional OpenAI model override (defaults to gpt-4o-mini).
OPENAI_MODEL=
